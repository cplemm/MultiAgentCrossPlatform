# Deployment inputs
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-shipment-recovery-demo
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
COPILOT_STUDIO_ENVIRONMENT_ID=Default-00000000-0000-0000-0000-000000000000
COPILOT_STUDIO_SCHEMA_NAME=new_PurchasingPolicySpecialist

# Foundry inputs and generated outputs
AZURE_AI_PROJECT_NAME=shipment-recovery-demo
AZURE_AI_PROJECT_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-shipment-recovery-demo/providers/Microsoft.CognitiveServices/accounts/YOUR-ACCOUNT/projects/YOUR-PROJECT
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Orchestrator runtime
SHIPMENT_DEMO_MODE=connected
SHIPMENT_DATA_PATH=data/shipments.json
TOOLBOX_NAME=shipment-tools
SUPPLIER_A2A_BASE_URL=https://shipment-supplier-agent.example.azurecontainerapps.io
SUPPLIER_A2A_TIMEOUT_SECONDS=45
RECOVERY_PLANNER_AGENT_NAME=shipment-recovery-planner
RECOVERY_PLANNER_RESPONSES_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT/agents/shipment-recovery-planner/endpoint/protocols/openai/responses?api-version=v1

# Policy bridge OAuth and CPS target
POLICY_BRIDGE_URL=https://shipment-policy-bridge.example.azurecontainerapps.io/mcp
POLICY_BRIDGE_CLIENT_ID=00000000-0000-0000-0000-000000000000
POLICY_BRIDGE_CLIENT_SECRET=store-only-in-azd-and-container-app-secrets
POLICY_BRIDGE_AUDIENCE=api://00000000-0000-0000-0000-000000000000
POLICY_BRIDGE_REQUIRED_SCOPE=access_as_user
POLICY_BRIDGE_SCOPE_ID=00000000-0000-0000-0000-000000000000
POLICY_BRIDGE_REDIRECT_URL=https://YOUR-FOUNDRY-OAUTH-REDIRECT
HOST=0.0.0.0
PORT=8000

# Supplier runtime
PUBLIC_BASE_URL=https://shipment-supplier-agent.example.azurecontainerapps.io
INVENTORY_PATH=data/inventory.json

# Recovery Planner runtime
RECOVERY_PLANNER_MODE=deterministic

# Generated component deployment outputs
POLICY_BRIDGE_CONTAINER_APP_NAME=shipment-policy-bridge
SUPPLIER_CONTAINER_APP_NAME=shipment-supplier-agent
