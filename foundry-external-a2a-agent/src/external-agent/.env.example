# Required Entra resource API settings
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_SECRET=store-in-container-app-secret

# Token-validation settings
API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
API_REQUIRED_SCOPE=access_as_user

# Public A2A card and JSON-RPC base URL
PUBLIC_BASE_URL=https://external-graph-profile-agent.example.azurecontainerapps.io

# HTTP listener
PORT=8000
