# Deployment inputs (set through deploy.ps1 parameters or azd env set)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-foundry-external-a2a-agent
AZURE_ENV_NAME=external-a2a-obo-demo
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# External A2A deployment
EXTERNAL_RESOURCE_GROUP=rg-foundry-external-a2a-agent
EXTERNAL_CONTAINER_APP_NAME=external-graph-profile-agent
EXTERNAL_A2A_BASE_URL=https://external-graph-profile-agent.example.azurecontainerapps.io

# External resource API (generated by create-entra-apps.ps1)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
EXTERNAL_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
EXTERNAL_API_CLIENT_SECRET=store-only-in-azd-and-container-app-secrets
EXTERNAL_API_SCOPE_ID=00000000-0000-0000-0000-000000000000
EXTERNAL_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Foundry OAuth client (generated by create-entra-apps.ps1)
FOUNDRY_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_OAUTH_CLIENT_SECRET=store-only-in-the-ignored-azd-environment
FOUNDRY_OAUTH_REDIRECT_URL=https://global.consent.azure-apim.net/redirect/replace-me

# Foundry outputs and caller configuration
AZURE_AI_PROJECT_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry-external-a2a-agent/providers/Microsoft.CognitiveServices/accounts/replace-me/projects/replace-me
FOUNDRY_PROJECT_ENDPOINT=https://replace-me.services.ai.azure.com/api/projects/replace-me
FOUNDRY_CALLER_AGENT_NAME=external-profile-orchestrator
EXTERNAL_A2A_CONNECTION_NAME=external-graph-profile-oauth
EXTERNAL_A2A_CONNECTION_KIND=RemoteTool
