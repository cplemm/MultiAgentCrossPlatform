# Azure/azd deployment inputs
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=rg-stock-agent-demo
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Public bridge endpoint and shared demo app registration
CPS_BRIDGE_URL=https://cps-stock-bridge.<environment>.<region>.azurecontainerapps.io/mcp
CPS_BRIDGE_CLIENT_ID=00000000-0000-0000-0000-000000000000
CPS_BRIDGE_CLIENT_SECRET=replace-with-current-secret-value
CPS_BRIDGE_AUDIENCE=api://00000000-0000-0000-0000-000000000000
CPS_BRIDGE_REQUIRED_SCOPE=access_as_user

# Published Standard-harness Copilot Studio target
COPILOT_STUDIO_ENVIRONMENT_ID=Default-00000000-0000-0000-0000-000000000000
COPILOT_STUDIO_SCHEMA_NAME=new_FinancialMarketResearchAgent

# Local/default runtime values
TOOLBOX_NAME=stock-tools
HOST=0.0.0.0
PORT=8000

# Populated by azd after deployment; not required before azd up
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
