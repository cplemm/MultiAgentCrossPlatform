# Required Foundry runtime values
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
TOOLBOX_NAME=stock-tools

# Optional local server override
PORT=8088

# Optional for non-Azure-CLI local authentication. Leave unset when using
# az login / DefaultAzureCredential.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-with-local-development-secret
